# Root .gitignore for POP project

# dependencies
**/node_modules/
**/.pnp
**.pnp.*
**/.yarn/

# next.js
**/ .next/
**/out/

# production
**/build/

# misc
.DS_Store
*.pem
*.rtf
extract.js
extracted_original/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
